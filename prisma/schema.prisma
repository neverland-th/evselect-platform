// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  shopeeId  String?
  wooId     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Vehicle {
  id        String    @id @default(cuid())
  make      String
  model     String
  year      String
  variant   String
  fitments  Fitment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([make, model, year, variant])
}

model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  title       String
  description String?
  categoryId         String
  category           Category  @relation(fields: [categoryId], references: [id])
  batches            Batch[]
  shopeeItemId       String?
  shopeeShopId       String?   @default("9535932")
  shopeeStock        Int?
  shopeePrice        Float?
  shopeeLastSyncedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Batch {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  supplierName String
  supplierUrl  String?
  cost         Float?
  moq          Int?
  leadTimeDays Int?
  status       String    @default("SHORTLISTED") // SHORTLISTED, SAMPLE_ORDERED, SAMPLE_IN_TRANSIT, SAMPLE_RECEIVED, ACTIVE, DISCONTINUED
  fitments     Fitment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Fitment {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  status    String   @default("UNVERIFIED") // UNVERIFIED, TEST_SCHEDULED, PASSED, PASSED_WITH_MODIFICATION, FAILED, RETEST_REQUIRED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, vehicleId])
}
