index 0000000..800e388
--- /dev/null
+++ b/src/app/typography.css
@@ -0,0 +1,58 @@
+/* Shared Thai typography: respect browser text scaling at every breakpoint. */
+:root {
+  --text-xs: 0.8125rem;
+  --text-xs--line-height: 1.6;
+  --text-sm: 0.9375rem;
+  --text-sm--line-height: 1.6;
+}
+
+html { font-size: 100%; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
+body { font-size: 1rem; line-height: 1.65; }
+
+/* Legacy cards and admin badges used fixed 9–12px text. */
+:is([class~="text-[9px]"], [class~="text-[10px]"], [class~="text-[11px]"], [class~="text-[12px]"]) {
+  font-size: 0.8125rem;
+  line-height: 1.6;
+}
+
+main { min-width: 0; }
+main :is(h1, h2, h3, h4) { overflow-wrap: anywhere; text-wrap: balance; }
+main h1 { font-size: clamp(1.875rem, 1.25rem + 2.2vw, 3rem); line-height: 1.3; }
+main h2 { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); line-height: 1.4; }
+main h3 { font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem); line-height: 1.45; }
+
+/* Article body copy uses 16px; captions and badges retain the smaller scale. */
+main > article { --text-sm: 1rem; --text-sm--line-height: 1.7; }
+main > article :is(p, li) { overflow-wrap: break-word; }
+main > article :is([class~="text-[14px]"], [class~="text-[15px]"]) { font-size: 1rem; line-height: 1.7; }
+main > article :is(td, th) { line-height: 1.65; }
+main > article a { overflow-wrap: anywhere; }
+main > article :is(sub, sup) { font-size: max(0.75rem, 0.75em); }
+main > article p.text-xs { font-size: 0.875rem; line-height: 1.7; }
+
+.storefront-shell > header nav { flex-shrink: 1; gap: 1rem; }
+.storefront-shell > header nav a { white-space: nowrap; }
+.storefront-mobile-nav { display: none; }
+
+@media (max-width: 1279px) {
+  .storefront-shell > header nav { display: none; }
+  .storefront-mobile-nav { display: flex; overflow-x: auto; gap: 1.25rem; padding: 0.65rem 1rem; border-bottom: 1px solid #e2e8f0; font-size: 0.9375rem; }
+  .storefront-mobile-nav a { flex-shrink: 0; }
+}
+
+@media (max-width: 1023px) {
+  .admin-shell { flex-direction: column; height: auto; min-height: 100vh; overflow: visible; }
+  .admin-shell > aside { width: 100%; }
+  .admin-shell > aside nav { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.75rem; }
+  .admin-shell > aside nav > div, .admin-shell > aside > div:last-child { display: none; }
+  .admin-shell > main { width: 100%; overflow: auto; }
+  .admin-shell main form { flex-wrap: wrap; }
+  .admin-shell main form > * { min-width: 0; max-width: 100%; }
+  .admin-shell main table { display: block; max-width: 100%; overflow-x: auto; }
+}
+
+@media (max-width: 767px) {
+  /* 16px inputs remain readable and avoid focus zoom on mobile Safari. */
+  :is(input:not([type="checkbox"]):not([type="radio"]), select, textarea) { font-size: 1rem; line-height: 1.5; }
+  .admin-shell main .grid-cols-2 { grid-template-columns: minmax(0, 1fr); }
+}
